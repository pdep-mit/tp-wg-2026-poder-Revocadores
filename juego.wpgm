import wollok.game.*
import jugadores.*
import pelota.*
import cajas.*

program PongRevocador {
	game.title("Revocadores | Pong Revocador")
	game.height(10)
	game.width(10)

	// Visuales de jugadores y pelota
	game.addVisual(jugador1)
	game.addVisual(jugador2)
	game.addVisual(pelota)

	// Cajas en cancha (polimorfismo con pelota)
	const cajaAceleradora = new CajaAceleradora(position = game.at(4, 7), incremento = 1)
	const cajaInversora = new CajaInversora(position = game.at(5, 2))
	const cajaFreno = new CajaFreno(position = game.at(5, 6), decremento = 1)
	game.addVisual(cajaAceleradora)
	game.addVisual(cajaInversora)
	game.addVisual(cajaFreno)

	// Controles
	keyboard.w().onPressDo({ jugador1.subir() })
	keyboard.s().onPressDo({ jugador1.bajar() })
	keyboard.up().onPressDo({ jugador2.subir() })
	keyboard.down().onPressDo({ jugador2.bajar() })

	// Colisiones polimorficas: cualquier elemento que choca con la pelota entiende colisionarConPelota
	game.onCollideDo(pelota, { elemento =>
		elemento.colisionarConPelota(pelota)
	})

	// Bucle de juego: movimiento de pelota y chequeo de tantos
	game.onTick(300, "moverPelota", {
		pelota.mover()

		// Verificacion de gol segun si supero la linea defensiva
		if (pelota.position().x() == 0 and pelota.direccionX() < 0) {
			jugador2.anotarPunto()
			pelota.reiniciar(game.at(5, 5))
		} else if (pelota.position().x() == 9 and pelota.direccionX() > 0) {
			jugador1.anotarPunto()
			pelota.reiniciar(game.at(5, 5))
		}
	})

	game.start()
}
