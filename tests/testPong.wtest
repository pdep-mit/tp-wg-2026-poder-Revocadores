import wollok.game.*
import jugadores.*
import pelota.*
import cajas.*

describe "Lógica de Jugadores" {
  test "el jugador sube y baja su posición" {
    const jugador = new Jugador(position = game.at(1, 4), limiteSuperior = 9, limiteInferior = 0)
    jugador.subir()
    assert.equals(game.at(1, 5), jugador.position())
    jugador.bajar()
    assert.equals(game.at(1, 4), jugador.position())
  }

  test "el jugador no puede pasar el límite superior ni inferior" {
    const jugador = new Jugador(position = game.at(1, 9), limiteSuperior = 9, limiteInferior = 0)
    jugador.subir()
    assert.equals(game.at(1, 9), jugador.position())

    const jugadorBajo = new Jugador(position = game.at(1, 0), limiteSuperior = 9, limiteInferior = 0)
    jugadorBajo.bajar()
    assert.equals(game.at(1, 0), jugadorBajo.position())
  }

  test "el jugador anota puntos correctamente" {
    const jugador = new Jugador(position = game.at(1, 4))
    jugador.anotarPunto()
    assert.equals(1, jugador.puntos())
  }
}

describe "Polimorfismo de Cajas Power-Up con la Pelota" {
  method initialize() {
    pelota.reiniciar(game.at(5, 5))
  }

  test "caja aceleradora aumenta la velocidad de la pelota" {
    const caja = new CajaAceleradora(position = game.at(5, 5), incremento = 2)
    caja.aplicarEfecto(pelota)
    assert.equals(3, pelota.velocidad())
  }

  test "caja freno reduce la velocidad de la pelota sin ser menor a 1" {
    pelota.aumentarVelocidad(2) // velocidad = 3
    const caja = new CajaFreno(position = game.at(5, 5), decremento = 1)
    caja.aplicarEfecto(pelota)
    assert.equals(2, pelota.velocidad())

    caja.aplicarEfecto(pelota)
    caja.aplicarEfecto(pelota) // no baja de 1
    assert.equals(1, pelota.velocidad())
  }

  test "caja inversora invierte la dirección vertical de la pelota" {
    const direccionInicialY = pelota.direccionY()
    const caja = new CajaInversora(position = game.at(5, 5))
    caja.aplicarEfecto(pelota)
    assert.equals(-direccionInicialY, pelota.direccionY())
  }
}
