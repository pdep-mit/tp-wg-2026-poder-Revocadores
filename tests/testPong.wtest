import wollok.game.*
import jugadores.*
import pelota.*
import cajas.*

describe "Lógica de Jugadores" {
  test "el jugador sube y baja su posición" {
    const jugador = new Jugador(
      position = game.at(1, 4),
      limiteSuperior = 7,
      limiteInferior = 1,
      nombre = "Jugador 1",
      direccionSaque = 1
    )

    jugador.subir()
    assert.equals(game.at(1, 5), jugador.position())

    jugador.bajar()
    assert.equals(game.at(1, 4), jugador.position())
  }

  test "el jugador no puede pasar el límite superior ni inferior" {
    const jugador = new Jugador(
      position = game.at(1, 9),
      limiteSuperior = 7,
      limiteInferior = 1,
      nombre = "Jugador 1",
      direccionSaque = 1
    )

    jugador.subir()
    assert.equals(game.at(1, 9), jugador.position())

    const jugadorBajo = new Jugador(
      position = game.at(1, 0),
      limiteSuperior = 7,
      limiteInferior = 1,
      nombre = "Jugador 1",
      direccionSaque = 1
    )

    jugadorBajo.bajar()
    assert.equals(game.at(1, 0), jugadorBajo.position())
  }

  test "el jugador anota puntos correctamente" {
    const jugador = new Jugador(
      position = game.at(1, 4),
      nombre = "Jugador 1",
      direccionSaque = 1
    )

    jugador.anotarPunto()

    assert.equals(1, jugador.puntos())
  }

  test "JugadorMaquina ignora movimientos manuales" {
    const bot = new JugadorMaquina(
      position = game.at(11, 4),
      nombre = "la Máquina",
      direccionSaque = -1
    )

    bot.moverManualArriba()
    assert.equals(game.at(11, 4), bot.position())

    bot.moverManualAbajo()
    assert.equals(game.at(11, 4), bot.position())
  }

  test "JugadorMaquina sigue la pelota cada 150ms e ignora pelota null" {
    const bot = new JugadorMaquina(
      position = game.at(11, 4),
      nombre = "la Máquina",
      direccionSaque = -1
    )
    const pelota = new Pelota(position = game.at(6, 6), direccionX = 1, direccionY = 1, velocidad = 1)

    bot.actualizarEnTick(null)
    assert.equals(game.at(11, 4), bot.position())

    bot.actualizarEnTick(pelota)
    bot.actualizarEnTick(pelota)
    assert.equals(game.at(11, 4), bot.position())

    bot.actualizarEnTick(pelota)
    assert.equals(game.at(11, 5), bot.position())
  }

}

describe "Polimorfismo de Cajas Power-Up con la Pelota" {

  test "caja aceleradora aumenta la velocidad de la pelota" {
    const pelota = new Pelota(position = game.at(5, 5), direccionX = 1, direccionY = 1, velocidad = 1)
    const caja = new CajaAceleradora(
      position = game.at(5, 5),
      incremento = 2
    )

    caja.colisionarConPelota(pelota)

    assert.equals(3, pelota.velocidad())
  }

  test "caja freno reduce la velocidad sin ser menor a 1" {
    const pelota = new Pelota(position = game.at(5, 5), direccionX = 1, direccionY = 1, velocidad = 1)
    const caja = new CajaFreno(
      position = game.at(5, 5),
      decremento = 1
    )

    pelota.aumentarVelocidad(2)
    assert.equals(3, pelota.velocidad())

    caja.colisionarConPelota(pelota)
    assert.equals(2, pelota.velocidad())

    caja.colisionarConPelota(pelota)
    caja.colisionarConPelota(pelota)

    assert.equals(1, pelota.velocidad())
  }

  test "caja inversora invierte la dirección vertical" {
    const pelota = new Pelota(position = game.at(5, 5), direccionX = 1, direccionY = 1, velocidad = 1)
    const direccionInicialY = pelota.direccionY()
    const caja = new CajaInversora(position = game.at(5, 5))

    caja.colisionarConPelota(pelota)

    assert.equals(-direccionInicialY, pelota.direccionY())
  }

  test "la pelota rebota verticalmente al alcanzar el límite superior" {
    const pelota = new Pelota(position = game.at(5, 8), direccionX = 1, direccionY = 1, velocidad = 1)

    pelota.direccionY(1)
    pelota.mover()

    assert.equals(-1, pelota.direccionY())
  }

  test "caja duplicadora duplica la pelota en el administrador" {
    administradorDePelotas.eliminarTodas()
    const pelota = new Pelota(position = game.at(5, 5), direccionX = 1, direccionY = 1, velocidad = 1)
    administradorDePelotas.agregar(pelota)
    const caja = new CajaDuplicadora(position = game.at(5, 5))

    const cantidadInicial = game.allVisuals().size()
    caja.colisionarConPelota(pelota)

    assert.equals(cantidadInicial + 1, game.allVisuals().size())
  }

  test "caja power-up activa su efecto con hitbox ampliada de 3x3" {
    const pelota = new Pelota(position = game.at(4, 4), direccionX = 1, direccionY = 1, velocidad = 1)
    const caja = new CajaAceleradora(position = game.at(5, 5), incremento = 1)
    administradorDeCajas.agregar(caja)

    administradorDeCajas.verificarColisiones(pelota)

    assert.equals(2, pelota.velocidad())
  }
}
