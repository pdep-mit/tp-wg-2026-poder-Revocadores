import wollok.game.*
import jugadores.*
import pelota.*
import cajas.*

describe "Lógica de Jugadores" {
  test "el jugador sube y baja su posición" {
    const jugador = new Jugador(
      position = game.at(1, 4),
      limiteSuperior = 7,
      limiteInferior = 1
    )

    jugador.subir()
    assert.equals(game.at(1, 5), jugador.position())

    jugador.bajar()
    assert.equals(game.at(1, 4), jugador.position())
  }

  test "el jugador no puede pasar el límite superior ni inferior" {
    const jugador = new Jugador(
      position = game.at(1, 9),
      limiteSuperior = 7,
      limiteInferior = 1
    )

    jugador.subir()
    assert.equals(game.at(1, 9), jugador.position())

    const jugadorBajo = new Jugador(
      position = game.at(1, 0),
      limiteSuperior = 7,
      limiteInferior = 1
    )

    jugadorBajo.bajar()
    assert.equals(game.at(1, 0), jugadorBajo.position())
  }

  test "el jugador anota puntos correctamente" {
    const jugador = new Jugador(position = game.at(1, 4))

    jugador.anotarPunto()

    assert.equals(1, jugador.puntos())
  }
}

describe "Polimorfismo de Cajas Power-Up con la Pelota" {

  test "caja aceleradora aumenta la velocidad de la pelota" {
    const pelota = new Pelota(position = game.at(5, 5))
    const caja = new CajaAceleradora(
      position = game.at(5, 5),
      incremento = 2
    )

    caja.colisionarConPelota(pelota)

    assert.equals(3, pelota.velocidad())
  }

  test "caja freno reduce la velocidad sin ser menor a 1" {
    const pelota = new Pelota(position = game.at(5, 5))
    const caja = new CajaFreno(
      position = game.at(5, 5),
      decremento = 1
    )

    pelota.aumentarVelocidad(2)
    assert.equals(3, pelota.velocidad())

    caja.colisionarConPelota(pelota)
    assert.equals(2, pelota.velocidad())

    caja.colisionarConPelota(pelota)
    caja.colisionarConPelota(pelota)

    assert.equals(1, pelota.velocidad())
  }

  test "caja inversora invierte la dirección vertical" {
    const pelota = new Pelota(position = game.at(5, 5))
    const direccionInicialY = pelota.direccionY()
    const caja = new CajaInversora(position = game.at(5, 5))

    caja.colisionarConPelota(pelota)

    assert.equals(-direccionInicialY, pelota.direccionY())
  }

  test "la pelota rebota verticalmente al alcanzar el límite superior" {
    const pelota = new Pelota(position = game.at(5, 8))

    pelota.direccionY(1)
    pelota.mover()

    assert.equals(-1, pelota.direccionY())
  }
}

describe "Lógica de Partida y Fin de Juego" {
  test "jugador alcanza el límite de puntos y resulta ganador" {
    const jugador = new Jugador(position = game.at(1, 4))
    assert.notThat(jugador.esGanador(3))
    jugador.anotarPunto()
    jugador.anotarPunto()
    jugador.anotarPunto()
    assert.that(jugador.esGanador(3))
  }

  test "detección de pelota que sale por los laterales de la cancha" {
    const pelotaIzquierda = new Pelota(position = game.at(0, 4), direccionX = -1)
    assert.that(pelotaIzquierda.salioPorIzquierda())
    assert.notThat(pelotaIzquierda.salioPorDerecha())

    const pelotaDerecha = new Pelota(position = game.at(12, 4), direccionX = 1)
    assert.that(pelotaDerecha.salioPorDerecha())
    assert.notThat(pelotaDerecha.salioPorIzquierda())
  }

  test "la caja power-up cambia de posición tras colisionar con la pelota" {
    const pelota = new Pelota(position = game.at(5, 5))
    const caja = new CajaInversora(position = game.at(5, 5))
    caja.colisionarConPelota(pelota)
    assert.that(caja.position().x() >= 3 and caja.position().x() <= 9)
    assert.that(caja.position().y() >= 1 and caja.position().y() <= 7)
  }
}
